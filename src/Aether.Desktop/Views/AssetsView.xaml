<UserControl x:Class="Aether.Desktop.Views.AssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Aether.Desktop.Views"
             xmlns:ctl="clr-namespace:Aether.Desktop.Controls">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="Asset Monitoring" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Weekly condition measurements that exist in the supplied case data, with their units, dates and source alarm/trip limits." />
            <Border Background="{StaticResource NoticeBackBrush}" CornerRadius="4" Padding="12,8" Margin="0,10,0,0"
                    Visibility="{Binding CoverageNote, Converter={StaticResource TextToVisible}}">
                <TextBlock Text="{Binding CoverageNote}" Foreground="{StaticResource NoticeTextBrush}" />
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding HasAssets, Converter={StaticResource BoolToCollapsed}}">
            <TextBlock Text="{Binding EmptyMessage}" FontSize="14" Style="{StaticResource Muted}" />
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0"
                   Visibility="{Binding HasAssets, Converter={StaticResource BoolToVisible}}">
            <TextBlock DockPanel.Dock="Top" Text="Assets with measurements" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                      AutomationProperties.Name="Assets with condition measurements">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tag" Width="95" Binding="{Binding Tag}" />
                    <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Records" Width="70" Binding="{Binding RecordCount}" ElementStyle="{StaticResource CellNumber}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasAssets, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Asset information (from the source equipment master)" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="L" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox DockPanel.Dock="Right" Width="260" ItemsSource="{Binding Parameters}"
                                      SelectedItem="{Binding SelectedParameter}" AutomationProperties.Name="Measured parameter" />
                            <TextBlock Text="Measurement history" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ctl:LineChart Height="270" Points="{Binding ChartPoints}" AlarmLimit="{Binding AlarmLimit}"
                                       TripLimit="{Binding TripLimit}" Unit="{Binding Unit}"
                                       Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.Name="Line chart of the selected parameter over time" />
                        <TextBlock Text="{Binding ChartMessage}" Style="{StaticResource Muted}" FontSize="14" Margin="0,8"
                                   Visibility="{Binding ChartMessage, Converter={StaticResource TextToVisible}}" />
                        <TextBlock Text="{Binding LimitText}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding RecordSummary}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Recorded measurements (selected parameter, newest first)" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Records}" MaxHeight="320" AutomationProperties.Name="Recorded measurements">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Width="100" Binding="{Binding MeasuredOn, StringFormat=yyyy-MM-dd}" />
                                <DataGridTextColumn Header="Week" Width="60" Binding="{Binding WeekNo}" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="Value" Width="90" Binding="{Binding Value, StringFormat=N2}" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="Unit" Width="70" Binding="{Binding Unit, TargetNullValue=—}" />
                                <DataGridTextColumn Header="Alarm limit" Width="95" Binding="{Binding AlarmLimit, StringFormat=N2, TargetNullValue=—}" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="Trip limit" Width="85" Binding="{Binding TripLimit, StringFormat=N2, TargetNullValue=—}" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="Health status" Width="105" Binding="{Binding HealthStatus, TargetNullValue=—}" />
                                <DataGridTextColumn Header="Remark" Width="*" Binding="{Binding Remark, TargetNullValue=—}" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <views:StatusMessage Grid.Row="2" Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
