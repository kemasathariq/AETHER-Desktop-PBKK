<UserControl x:Class="Aether.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Aether.Desktop.Views"
             xmlns:ctl="clr-namespace:Aether.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12">
        <StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                       Text="A clear view of incidents, impact and follow-up. Historical records from your local database, updated each time you open this page." />

            <TextBlock Text="Loading statistics…" Style="{StaticResource Muted}" FontSize="15" Margin="0,10"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{StaticResource Card}" Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Text="No incident data yet" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="The database has no incidents, so all statistics are zero. Add an incident on the Incidents page and this page will update." />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisible}}">
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Background="{StaticResource BlueCardBrush}" MinHeight="138">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="↗" FontSize="18" Foreground="White" /><TextBlock Text="Total incidents" Foreground="White" FontSize="12" /></DockPanel>
                            <TextBlock Text="{Binding TotalIncidentsText}" Style="{StaticResource BigNumber}" Foreground="White" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding ActiveIncidentsText}" Foreground="White" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Background="{StaticResource BlackCardBrush}" MinHeight="138">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="↗" FontSize="18" Foreground="White" /><TextBlock Text="Downtime" Foreground="White" FontSize="12" /></DockPanel>
                            <TextBlock Text="{Binding DowntimeText}" Style="{StaticResource BigNumber}" Foreground="White" FontSize="28" Margin="0,12,0,4" />
                            <TextBlock Text="Recorded hours" Foreground="#E0E0E0" FontSize="11" ToolTip="{Binding DowntimeNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Background="{StaticResource BlueCardBrush}" MinHeight="138">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="↗" FontSize="18" Foreground="White" /><TextBlock Text="Actual loss" Foreground="White" FontSize="12" /></DockPanel>
                            <TextBlock Text="{Binding ActualLossText}" Style="{StaticResource BigNumber}" Foreground="White" FontSize="24" Margin="0,12,0,4" />
                            <TextBlock Text="Historical recorded loss" Foreground="White" FontSize="11" ToolTip="{Binding LossNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Background="{StaticResource BlackCardBrush}" MinHeight="138">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="↗" FontSize="18" Foreground="White" /><TextBlock Text="Actions tracked" Foreground="White" FontSize="12" /></DockPanel>
                            <TextBlock Text="{Binding ActionsText}" Style="{StaticResource BigNumber}" Foreground="White" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding ActionsNote}" Foreground="#E0E0E0" FontSize="11" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,6,0">
                        <StackPanel>
                            <TextBlock Text="Incidents by status" Style="{StaticResource SectionTitle}" Foreground="{StaticResource AccentBrush}" />
                            <ctl:BarChart Items="{Binding ByStatus}" LabelWidth="160" BarBrush="#DCDCDC"
                                          AutomationProperties.Name="Bar chart: incidents by status" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="6,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Incidents by plant (top 8)" Style="{StaticResource SectionTitle}" Foreground="{StaticResource GreenBrush}" />
                            <ctl:BarChart Items="{Binding ByPlant}" LabelWidth="60" BarBrush="#DCDCDC"
                                          AutomationProperties.Name="Bar chart: incidents by plant" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Incident activity" Style="{StaticResource SectionTitle}" Foreground="{StaticResource VioletBrush}" />
                            <TextBlock Text="Recorded incidents per month · latest 12 months with data" Style="{StaticResource Muted}" Margin="0,0,0,16" />
                            <ctl:LineChart Points="{Binding MonthlyTrend}" Height="220" AreaBrush="{StaticResource ChartAreaBrush}"
                                           AutomationProperties.Name="Line chart: recorded incidents per month" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Most recent incidents" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Recent}" AutomationProperties.Name="Most recent incidents"
                                  MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Width="100" MinWidth="100" Binding="{Binding OccurredOn, StringFormat=yyyy-MM-dd, TargetNullValue=—}" />
                                <DataGridTextColumn Header="Tag" Width="100" MinWidth="100" Binding="{Binding TagNumber}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Title" Width="*" Binding="{Binding Title}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Plant" Width="70" MinWidth="70" Binding="{Binding Plant}" />
                                <DataGridTemplateColumn Header="Status" Width="170" MinWidth="170" SortMemberPath="Status" ClipboardContentBinding="{Binding Status}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource BadgeBrush}}"><TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" FontSize="10" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Downtime (h)" Width="110" MinWidth="110" Binding="{Binding DowntimeHours, StringFormat=N1, TargetNullValue=—}" ElementStyle="{StaticResource CellNumber}" />
                                <DataGridTextColumn Header="Actual loss (k USD)" Width="140" MinWidth="140" Binding="{Binding ActualLossKUsd, StringFormat=N0, TargetNullValue=—}" ElementStyle="{StaticResource CellNumber}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <views:StatusMessage />
            <TextBlock Text="{Binding DowntimeNote}" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" />
            <TextBlock Text="{Binding LossNote}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
            <TextBlock Text="Historical case records and your entries. Recorded losses are not savings produced by the application."
                       Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
