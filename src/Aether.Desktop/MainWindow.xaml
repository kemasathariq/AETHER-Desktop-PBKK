<Window x:Class="Aether.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aether.Desktop.ViewModels"
        xmlns:views="clr-namespace:Aether.Desktop.Views"
        Title="AETHER Desktop" Width="1360" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentsViewModel}"><views:IncidentsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssetsViewModel}"><views:AssetsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PriorityViewModel}"><views:PriorityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActionsViewModel}"><views:ActionsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <TextBlock Text="AETHER" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Desktop · incident review" Foreground="#9CA3AF" FontSize="12" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="20,12,20,18" FontSize="11" Foreground="#9CA3AF"
                           Text="{Binding DataNote}" />

                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0" Margin="8,0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         AutomationProperties.Name="Main navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#E5E7EB" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="14" Foreground="#E5E7EB"
                                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0" IsTabStop="False" />
    </Grid>
</Window>
